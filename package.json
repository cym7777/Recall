{
  "name": "recall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本地优先的错题管理与间隔复习工具",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src tests scripts index.html *.json *.md"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.6.2"
  }
}
